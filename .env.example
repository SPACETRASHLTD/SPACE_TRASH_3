# ─── App ──────────────────────────────────────────────────────────────
# Public base URL of the deployed app. Used for OAuth redirects + SMS links.
# In dev: http://localhost:3000
# In prod: https://gigs.<your-agency>.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-tenant: the UUID of the one row in the `agencies` table.
# Set this after running the seed step in the README.
AGENCY_ID=

# ─── Supabase ─────────────────────────────────────────────────────────
# From your project's API settings page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google OAuth (Calendar API) ──────────────────────────────────────
# From a Google Cloud project with the Calendar API enabled.
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Twilio (SMS) ─────────────────────────────────────────────────────
# A2P 10DLC campaign must be registered before sending in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Overture ─────────────────────────────────────────────────────────
# API key from the agency's Overture Settings page.
OVERTURE_API_KEY=
# Set to whatever the API docs in Overture Settings specify.
OVERTURE_API_BASE_URL=

# ─── Encryption ───────────────────────────────────────────────────────
# 32-byte AES-GCM key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt Google refresh tokens + the Overture API key at rest.
TOKEN_ENCRYPTION_KEY=
