# ─────────────────────────────────────────────────────────────
# Vancouver House Party — environment variables
# Copy to .env.local for local dev; set the same keys in Render
# (dashboard → your service → Environment).
# NOTHING here is exposed to the browser except NEXT_PUBLIC_* keys.
# ─────────────────────────────────────────────────────────────

# Anthropic (Claude) — powers the booking assistant. Server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the model. Defaults to claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6

# Supabase — lead capture. The service role key is server-side ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...   # secret — never client-side

# Twilio — SMS notifications to the founders.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+16045551234   # a Twilio number you own, E.164 format

# Resend — email notifications to the founders.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Vancouver House Party <leads@yourdomain.com>"

# Founder destinations (comma-separated for multiple recipients).
FOUNDER_PHONES=+16045550001,+16045550002        # E.164, comma-separated
FOUNDER_EMAILS=stephen@example.com,sasha@example.com
